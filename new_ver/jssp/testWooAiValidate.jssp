<%
response.setContentType("application/json;charset=utf-8");
/*
 * testWooAiValidate.jssp (검증·카운트·카탈로그·SQL목록 통합)
 * ==========================================================
 * setContentType은 KA-14685대로 최상단.
 * 게이트: plan fragment DB active (allowedNames 폐기).
 *
 * [Endpoint]
 * =======================
 * POST /woo/testWooAiValidate.jssp
 *   action=validate|count|catalog|listSql|getSql
 *
 * [Dependencies]
 * =========
 * - woo:testWooCommon.js (+ Config/Fragments/Compiler/Gates/Repository by action)
 */
try {
  TW_RESPONSE = response;
  TW_REQUEST = request;
  TW_DOCUMENT = document;
  loadLibrary("woo:testWooCommon.js");
  requireRight("testWooAiSqlGenerate");

  var p = readPayload();
  var action = String(
    p.action || TW_REQUEST.getParameter("action") || "validate"
  ).toLowerCase();

  if (action === "catalog") {
    _runCatalog();
  } else if (action === "count") {
    _runCount(p);
  } else if (action === "validate") {
    _runValidate(p);
  } else if (action === "listsql") {
    _runListSql(p);
  } else if (action === "getsql") {
    _runGetSql(p);
  } else {
    throw new Error("unknown action: " + action + " (validate|count|catalog|listSql|getSql)");
  }
} catch (e) {
  handleApiError(e);
}

function _runCatalog() {
  loadLibrary("woo:testWooConfig.js");
  loadLibrary("woo:testWooFragments.js");
  jsonOut({ ok: true, categories: testWoo.fragments.listCategories() });
}

function _runCount(p) {
  if (!p.plan) throw new Error("plan missing");
  loadLibrary("woo:testWooConfig.js");
  loadLibrary("woo:testWooFragments.js");
  loadLibrary("woo:testWooCompiler.js");
  loadLibrary("woo:testWooGates.js");
  var compiled = testWoo.compiler.compile(p.plan);
  jsonOut({
    ok: true,
    sql: compiled.sql,
    keyColumn: compiled.keyColumn,
    funnel: [],
    finalCount: null,
    total: null
  });
}

function _runValidate(p) {
  if (!p.plan) throw new Error("plan missing");
  loadLibrary("woo:testWooConfig.js");
  loadLibrary("woo:testWooFragments.js");
  loadLibrary("woo:testWooCompiler.js");
  loadLibrary("woo:testWooGates.js");

  var compiled = testWoo.compiler.compile(p.plan);
  var results = testWoo.gates.runAll(p.plan, compiled.sql);
  var passed = true;
  for (var i = 0; i < results.length; i++) {
    if (!results[i].ok) { passed = false; break; }
  }
  jsonOut({
    ok: true,
    passed: passed,
    results: results,
    sql: compiled.sql,
    summary: compiled.summary,
    chips: testWoo.compiler.chipsFromPlan(p.plan),
    plan: p.plan
  });
}

function _runListSql(p) {
  var wf = String(p.workflow_name || p.workflowName || "").replace(/^\s+|\s+$/g, "");
  if (!wf) throw new Error("workflow_name missing");
  loadLibrary("woo:testWooRepository.js");
  var lim = p.limit != null ? Number(p.limit) : 50;
  jsonOut({
    ok: true,
    workflow_name: wf,
    items: testWoo.repo.listAiSqlByWorkflow(wf, lim)
  });
}

function _runGetSql(p) {
  var id = p.ai_sql_id != null ? p.ai_sql_id : p.id;
  if (id == null || id === "") throw new Error("ai_sql_id missing");
  loadLibrary("woo:testWooRepository.js");
  var item = testWoo.repo.getAiSqlById(id);
  if (!item) {
    jsonOut({ ok: false, error: "ai_sql not found", ai_sql_id: id });
    return;
  }
  jsonOut({ ok: true, item: item });
}
%>
