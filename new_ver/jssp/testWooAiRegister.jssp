<%
response.setContentType("application/json;charset=utf-8");
/*
 * testWooAiRegister.jssp (SQL 등록 API)
 * ==================================================
 * plan 재컴파일·gates 통과 후 woo:testWooAiSql에 ai_sql_id 저장.
 * workflow+sqlContentHash 중복 시 insert 스킵(created:false).
 *
 * [Main Functions]
 * ===========
 * - compile+runAll — gates 실패 시 registered 없이 results 반환
 * - findAiSqlBySqlHash — 동일 WKF·SQL 해시 dedup
 * - saveAiSql — usedFragments·compileHash 필수(CSRF)
 *
 * [Dependencies]
 * =========
 * - woo:testWooCommon.js, Config, Fragments, Compiler, Gates, Lifecycle, Repository
 * - right testWooAiSqlRegister · schema woo:testWooAiSql
 *
 * [Invariants]
 * ===========
 * - usedFragments 비면 등록 거부 — WF XML 직접 쓰기 없음
 * - gates 미통과 SQL은 woo:testWooAiSql에 insert 금지
 * - loadLibrary 직후 twRequireLib (#160)
 */
try {
  TW_RESPONSE = response;
  TW_REQUEST = request;
  TW_DOCUMENT = document;
  loadLibrary("woo:testWooCommon.js");
  requireRight("testWooAiSqlRegister");

  var p = readPayload();
  requireStudioCsrf(p);
  if (!p.plan) throw new Error("Register: plan missing");

  loadLibrary("woo:testWooConfig.js");
  loadLibrary("woo:testWooFragments.js");
  loadLibrary("woo:testWooCompiler.js");
  loadLibrary("woo:testWooGates.js");
  loadLibrary("woo:testWooLifecycle.js");
  loadLibrary("woo:testWooRepository.js");
  twRequireLib("woo:testWooFragments.js", (typeof testWoo !== "undefined") && testWoo.fragments);
  twRequireLib("woo:testWooCompiler.js", (typeof testWoo !== "undefined") && testWoo.compiler);
  twRequireLib("woo:testWooGates.js", (typeof testWoo !== "undefined") && testWoo.gates);
  twRequireLib("woo:testWooLifecycle.js", (typeof testWoo !== "undefined") && testWoo.lifecycle);
  twRequireLib("woo:testWooRepository.js", (typeof testWoo !== "undefined") && testWoo.repo);

  var compiled = testWoo.compiler.compile(p.plan);
  var results = testWoo.gates.runAll(p.plan, compiled.sql);
  var passed = true;
  for (var i = 0; i < results.length; i++) {
    if (!results[i].ok) { passed = false; break; }
  }
  if (!passed) {
    jsonOut({
      ok: true,
      passed: false,
      created: false,
      results: results,
      sql: compiled.sql,
      summary: compiled.summary,
      plan: p.plan,
      chips: testWoo.compiler.chipsFromPlan(p.plan),
      error: "validation failed — not registered"
    });
  } else {
    var used = testWoo.compiler.collectUsedFragments(p.plan);
    if (!used.length) throw new Error("[Register] usedFragments empty");
    var compileHash = testWoo.lifecycle.compileHash(p.plan, compiled.sql);
    var sqlHash = testWoo.lifecycle.sqlContentHash(compiled.sql);
    var wfName = String(p.workflow_name || "");

    if (wfName) {
      var dup = testWoo.repo.findAiSqlBySqlHash(wfName, sqlHash);
      if (dup && dup.id) {
        jsonOut({
          ok: true,
          passed: true,
          created: false,
          ai_sql_id: dup.id,
          status: dup.status || "registered",
          sql: compiled.sql,
          summary: compiled.summary,
          usedFragments: used,
          compileHash: compileHash,
          sqlHash: sqlHash,
          message:
            "\uB3D9\uC77C\uD55C SQL\uC774 \uC774\uBBF8 \uB4F1\uB85D\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. " +
            "\uC0C8 ID\uB97C \uB9CC\uB4E4\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. (ai_sql_id=" +
            dup.id +
            ")"
        });
      } else {
        var title = String(p.title || "");
        if (typeof TW_TITLE_MAX !== "undefined" && title.length > TW_TITLE_MAX)
          title = title.substring(0, TW_TITLE_MAX);

        var id = testWoo.repo.saveAiSql({
          title: title,
          creator: currentLogin(),
          nl_request: p.nl_request,
          plan_json: JSON.stringify(p.plan),
          used_fragments: JSON.stringify(used),
          compile_hash: compileHash,
          sql_query: compiled.sql,
          summary_ko: compiled.summary || p.summary,
          target_count: p.target_count != null ? p.target_count : 0,
          workflow_name: wfName,
          excluded_slots: p.excluded_slots ? JSON.stringify(p.excluded_slots) : "",
          status: "registered"
        });
        jsonOut({
          ok: true,
          passed: true,
          created: true,
          ai_sql_id: id,
          status: "registered",
          sql: compiled.sql,
          summary: compiled.summary,
          usedFragments: used,
          compileHash: compileHash,
          sqlHash: sqlHash
        });
      }
    } else {
      var title2 = String(p.title || "");
      if (typeof TW_TITLE_MAX !== "undefined" && title2.length > TW_TITLE_MAX)
        title2 = title2.substring(0, TW_TITLE_MAX);

      var id2 = testWoo.repo.saveAiSql({
        title: title2,
        creator: currentLogin(),
        nl_request: p.nl_request,
        plan_json: JSON.stringify(p.plan),
        used_fragments: JSON.stringify(used),
        compile_hash: compileHash,
        sql_query: compiled.sql,
        summary_ko: compiled.summary || p.summary,
        target_count: p.target_count != null ? p.target_count : 0,
        workflow_name: "",
        excluded_slots: p.excluded_slots ? JSON.stringify(p.excluded_slots) : "",
        status: "registered"
      });
      jsonOut({
        ok: true,
        passed: true,
        created: true,
        ai_sql_id: id2,
        status: "registered",
        sql: compiled.sql,
        summary: compiled.summary,
        usedFragments: used,
        compileHash: compileHash,
        sqlHash: sqlHash
      });
    }
  }
} catch (e) {
  handleApiError(e);
}
%>
