<%/*
 * testWooAiStudio.jssp (Studio UI 셸)
 * ==================================================
 * Cookie __sessiontoken→logonWithToken 후 HTML 셸 렌더.
 * embed/urlViewer(IE)용 table 레이아웃·Option 주입·litmus v=.
 * #nlHints는 NL 입력창 위 보강 칩(카드 치환 칩 없음).
 *
 * [Main Functions]
 * ===========
 * - auth gate — 미인증 시 안내 페이지(redirect 대신)
 * - shell layout — #twInfoBar + #twMainTable 2열(table+고정 px)
 * - embed mode — ?embed=1 크롬리스 · ?workflowName= SQL 이력
 * - Option inject — __TW_MATCH_ENABLED__ 등 StudioJs 전역
 *
 * [Dependencies]
 * =========
 * - /woo/testWooAiStudioJs.jssp?v=193 — 클라이언트 IIFE (라벨 모달·Register nl)
 * - Option testWooAiMatchEnabled — 1/true만 ON
 * - input_form testWooExtendWorkflow — urlViewer height=630(embed 본문+70 정합)
 *
 * [Invariants]
 * ===========
 * - MSHTML: fetch/Promise/flex/CSS변수 금지 · 한글 HTML 엔티티
 * - litmus URL v=193 필수
 * - NL textarea·목록 고정 height(+70) — 단독 630 / embed 510
 */
response.setContentType("text/html;charset=utf-8");
try {
  response.addHeader("Cache-Control", "no-store, no-cache, must-revalidate");
  response.addHeader("Pragma", "no-cache");
} catch (eHdr) {}

function _twEscJs(s) {
  return String(s || "")
    .replace(/\\/g, "\\\\")
    .replace(/'/g, "\\'")
    .replace(/\r/g, "")
    .replace(/\n/g, "");
}

/* #152: Match UI 킬스위치. 기본 OFF — 오탐(값 무시) 차단. 1/true 만 활성. */
function _twMatchEnabled() {
  try {
    var raw = String(getOption("testWooAiMatchEnabled") || "");
    raw = raw.replace(/^\s+|\s+$/g, "").toLowerCase();
    return raw === "1" || raw === "true" || raw === "yes" || raw === "on";
  } catch (eOpt) {
    return false;
  }
}
var _matchEnabled = _twMatchEnabled();

function _twHtmlEsc(s) {
  return String(s || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

// Cookie 헤더 우선
function _twCookie(name) {
  try {
    var hdr = String(request.getHeader("Cookie") || "");
    var parts = hdr.split(";");
    for (var j = 0; j < parts.length; j++) {
      var p = parts[j].replace(/^\s+/, "");
      var eq = p.indexOf("=");
      if (eq < 0) continue;
      if (p.substring(0, eq) === name) return p.substring(eq + 1);
    }
  } catch (e1) {}
  try {
    var cs = request.cookies;
    if (cs && cs.length != null) {
      for (var i = 0; i < cs.length; i++) {
        if (String(cs[i].name) === name) return String(cs[i].value || "");
      }
    }
  } catch (e2) {}
  return "";
}

var _wf = String(request.getParameter("workflowName") || "");
var _embed = String(request.getParameter("embed") || "") === "1";
var _studioUrl = "/woo/testWooAiStudio.jssp";
var _qs = [];
if (_wf) _qs.push("workflowName=" + encodeURIComponent(_wf));
if (_embed) _qs.push("embed=1");
if (_qs.length) _studioUrl += "?" + _qs.join("&");
var _logonUrl = "/nl/jsp/logon.jsp?target=" + encodeURIComponent(_studioUrl);

var _login = "";
try { _login = String(application.operator.login || ""); } catch (eLogin) { _login = ""; }

if (!_login) {
  var _tok = _twCookie("__sessiontoken");
  if (_tok) {
    try {
      // logon(sessionToken)은 JST-310036 으로 폐기 — 현행 API는 logonWithToken.
      // Common 을 로드하지 않는 UI 셸이라 여기서 직접 가드한다.
      if (typeof logonWithToken === "function") logonWithToken(_tok);
      else logon(_tok);
      _login = String(application.operator.login || "");
    } catch (eBind) { _login = ""; }
  }
}

if (!_login) {
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- WebBrowser(urlViewer) 기본 IE7 호환 모드 회피 — 반드시 charset 직후 -->
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Test Woo AI Studio — Sign in</title>
  <style>
    body{font-family:system-ui,"Segoe UI",sans-serif;background:#f0f2f5;margin:0;padding:48px 16px;}
    .box{max-width:420px;margin:0 auto;background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:24px;}
    h1{font-size:1.1rem;margin:0 0 8px;} p{color:#64748b;font-size:.9rem;margin:0 0 16px;line-height:1.5;}
    a.btn{display:inline-block;padding:10px 18px;background:#2563eb;color:#fff;text-decoration:none;border-radius:8px;font-weight:600;}
    code{font-size:.8rem;background:#f8fafc;padding:2px 6px;border-radius:4px;}
  </style>
</head>
<body>
  <div class="box">
    <h1>Test Woo AI Studio</h1>
    <p>Campaign operator session required. Sign in, then return to this Studio URL (bookmark it).</p>
    <p>Studio URL:<br/><code><%= _twHtmlEsc(_studioUrl) %></code></p>
    <p><a class="btn" href="<%= _twHtmlEsc(_logonUrl) %>">Sign in (Campaign logon)</a></p>
  </div>
</body>
</html>
<%
} else {
%>
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <!-- WebBrowser(urlViewer) 기본 IE7 호환 모드 회피 — 반드시 charset 직후, 다른 meta/script 보다 먼저 -->
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Test Woo AI Studio</title>
  <!-- IE8- 미인식 HTML5 태그 스타일링용 (urlViewer 구문서모드 대비) -->
  <script type="text/javascript">
  (function () {
    var t = "header,footer,main,aside,nav,details,summary,section,article".split(",");
    for (var i = 0; i < t.length; i++) {
      try { document.createElement(t[i]); } catch (eC) {}
    }
  })();
  </script>
  <style type="text/css">
    /* IE11: var/flex/grid/vh/calc 금지 — table + 고정 px
     * 작업영역 630px: 좌(답변420+composer210) / 우(제목+목록570) — NL textarea +70 */
    header,footer,main,aside,nav,details,summary,section,article{display:block;}
    *{box-sizing:border-box;} html,body{height:100%;margin:0;}
    body{font-family:"Segoe UI",Tahoma,sans-serif;background:#f0f2f5;color:#0f172a;line-height:1.5;}
    .app{display:block;height:auto;max-width:1280px;margin:0 auto;background:#fff;border-left:1px solid #e2e8f0;border-right:1px solid #e2e8f0;}
    .header{display:block;padding:12px 16px;border-bottom:1px solid #e2e8f0;}
    .header h1{font-size:1rem;margin:0;display:inline;} .header .wf{font-size:.75rem;color:#64748b;display:block;margin-top:4px;}
    #twInfoBar{height:48px;line-height:48px;padding:0 12px;border-bottom:1px solid #e2e8f0;font-size:.85rem;color:#334155;overflow:hidden;background:#f8fafc;}
    #twInfoText{display:inline-block;max-width:70%;overflow:hidden;vertical-align:middle;white-space:nowrap;text-overflow:ellipsis;}
    #twInfoActions{display:inline-block;float:right;line-height:48px;}
    #twInfoActions .btn-mini{font:inherit;font-size:.75rem;font-weight:600;padding:4px 10px;margin-left:6px;cursor:pointer;border:1px solid #e2e8f0;border-radius:6px;background:#fff;color:#0f172a;vertical-align:middle;}
    .crumb{color:#2563eb;cursor:pointer;text-decoration:underline;}
    .crumb.cur{color:#334155;cursor:default;text-decoration:none;font-weight:600;}
    .crumb-sep{margin:0 5px;color:#94a3b8;text-decoration:none;cursor:default;}
    #twNlHint{font-size:.82rem;color:#b45309;padding:0 0 4px 0;height:20px;overflow:hidden;}
    #twNlHint.hidden{display:none !important;}
    .sql-item .badge-lock{display:inline-block;font-size:.68rem;font-weight:700;padding:1px 6px;margin-left:6px;border-radius:6px;background:#fffbeb;color:#b45309;border:1px solid #fcd34d;}
    .sql-item .nl-line{color:#0f172a;font-size:.78rem;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    #twMainTable{width:100%;height:630px;border-collapse:collapse;table-layout:fixed;}
    #twLeftCol{vertical-align:top;width:68%;height:630px;overflow:hidden;}
    #twListPane{vertical-align:top;width:32%;height:630px;overflow:hidden;border-left:1px solid #e2e8f0;background:#f8fafc;padding:8px 12px;}
    #twAnswer{height:420px;overflow:auto;padding:12px 16px;}
    #twListPane h2,#twListTitle{font-size:.78rem;margin:0 0 8px;height:22px;line-height:22px;overflow:hidden;color:#64748b;text-transform:uppercase;letter-spacing:.03em;}
    /* 목록: max-height 대신 고정 height — 빈 목록도 동일 창 높이 유지 */
    #twDummyList,#sideSql{height:570px;overflow:auto;}
    .list-sec{font-size:.78rem;font-weight:700;color:#334155;margin:12px 0 6px;}
    .list-sec.first{margin-top:0;}
    .sql-search{margin:0 0 8px;}
    .sql-search .sql-search-lab{font-size:.72rem;color:#64748b;margin:0 0 4px;}
    .sql-search input{display:block;width:100%;box-sizing:border-box;font:inherit;border:1px solid #e2e8f0;border-radius:8px;padding:8px 10px;}
    .chip-line{font-size:.9rem;color:#0f172a;margin:0 0 8px;line-height:1.4;}
    .shell-item{border:1px solid #e2e8f0;border-radius:10px;padding:10px;margin-bottom:8px;cursor:pointer;background:#fff;font-size:.82rem;}
    .shell-item .meta{color:#64748b;font-size:.72rem;margin-top:4px;}
    .shell-item:hover,.shell-item.active{border-color:#2563eb;background:#eff6ff;}
    .shell-item.draft-cache{border-color:#f59e0b;background:#fffbeb;}
    .shell-item.draft-cache:hover{border-color:#d97706;background:#fef3c7;}
    .shell-item.locked{opacity:0.55;cursor:not-allowed;background:#f8fafc;}
    .shell-item.locked:hover{border-color:#e2e8f0;background:#f8fafc;}
    .shell-item.orphan{border-color:#fca5a5;background:#fef2f2;}
    .shell-item.orphan:hover{border-color:#ef4444;background:#fee2e2;}
    .badge-orphan{display:inline-block;font-size:.68rem;font-weight:700;padding:1px 6px;margin-left:6px;border-radius:6px;background:#fef2f2;color:#b91c1c;border:1px solid #fca5a5;}
    .side{display:block;overflow:auto;padding:0;background:transparent;}
    .side.hidden{display:none;}
    .sql-item{position:relative;border:1px solid #e2e8f0;border-radius:10px;padding:10px 48px 10px 10px;margin-bottom:8px;cursor:pointer;background:#fff;font-size:.82rem;}
    .sql-item:hover,.sql-item.active{border-color:#2563eb;background:#eff6ff;}
    .sql-item.current{border-color:#059669;background:#ecfdf5;}
    .sql-item.current:hover,.sql-item.current.active{border-color:#047857;background:#d1fae5;}
    .sql-item .badge-now{display:inline-block;font-size:.68rem;font-weight:700;padding:1px 6px;margin-left:6px;background:#d1fae5;color:#047857;border:1px solid #6ee7b7;}
    .sql-item .badge-time,.gate .badge-time{display:inline-block;font-size:.68rem;font-weight:700;padding:1px 6px;margin-left:6px;border-radius:6px;}
    .badge-time-abs{background:#eff6ff;color:#1d4ed8;border:1px solid #93c5fd;}
    .badge-time-rel{background:#fef3c7;color:#92400e;border:1px solid #fcd34d;}
    .sql-item.new-sql{border-color:#f59e0b;background:#fffbeb;}
    .sql-item.new-sql:hover,.sql-item.new-sql.active{border-color:#d97706;background:#fef3c7;}
    .sql-item.locked{opacity:0.55;cursor:not-allowed;background:#f8fafc;}
    .sql-item.locked:hover{border-color:#e2e8f0;background:#f8fafc;}
    .sql-item .sid{font-weight:700;color:#2563eb;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .sql-item .meta{color:#64748b;font-size:.72rem;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .sql-item button.sql-del{position:absolute;right:6px;top:8px;font:inherit;font-size:.7rem;font-weight:600;
      padding:3px 8px;cursor:pointer;border:1px solid #fca5a5;background:#fef2f2;color:#b91c1c;border-radius:6px;}
    .sql-item button.sql-del:hover{background:#fee2e2;}
    .sql-item button.sql-del.confirm{background:#b91c1c;color:#fff;border-color:#991b1b;}
    #twBootTable,#twBoot{display:none;}
    #twBootTable.tw-boot-show,#twBoot.tw-boot-show{display:block;}
    #twBoot{padding:3px 8px;background:#fffbeb;color:#92400e;font:11px/1.35 Tahoma,sans-serif;border-bottom:1px solid #f59e0b;}
    #twRecentNl{margin:0;padding:6px 12px 8px;border-top:1px solid #e2e8f0;background:#fff;font-size:.75rem;color:#334155;}
    #twRecentNl .tw-rq-h{font-weight:600;margin:0 0 4px;color:#64748b;}
    #twRecentNl a.tw-rq{display:block;padding:3px 0;color:#2563eb;cursor:pointer;text-decoration:none;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    #twRecentNl .tw-rq-empty{color:#94a3b8;}
    #twDiag{margin:0;padding:6px 12px 10px;border-top:1px solid #e2e8f0;font-size:.72rem;color:#64748b;background:#f8fafc;}
    #twDiagSum{cursor:pointer;font-weight:600;}
    #twDiagLog{max-height:240px;overflow:auto;font-family:Consolas,monospace;white-space:pre-wrap;background:#fff;border:1px solid #e2e8f0;padding:8px;margin-top:6px;}
    .side-empty{font-size:.82rem;color:#64748b;line-height:1.45;}
    .card{border:1px solid #e2e8f0;border-radius:14px;padding:14px 16px;margin:0 0 12px 0;}
    .card h2{font-size:.85rem;margin:0 0 10px;color:#64748b;text-transform:uppercase;letter-spacing:.03em;}
    .chips{display:block;}
    .chip{display:inline-block;margin:0 6px 6px 0;background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;border-radius:999px;padding:6px 12px;font-size:.85rem;}
    .chip.unverified{background:#fffbeb;color:#92400e;border-color:#f59e0b;}
    .chip button{border:none;background:none;color:#2563eb;cursor:pointer;font-size:1rem;line-height:1;}
    .chip.unverified button{color:#92400e;}
    .chip button.chip-ok{font-size:.72rem;font-weight:700;margin-left:6px;padding:0 4px;color:#047857;}
    .gates{display:block;font-size:.85rem;}
    .gate{display:block;margin:0 0 6px 0;} .gate .g-ok{color:#047857;} .gate .g-err{color:#b91c1c;}
    pre.code{font-family:Consolas,monospace;font-size:.78rem;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:12px;overflow:auto;white-space:pre-wrap;max-height:220px;color:#0f766e;}
    .banner{padding:10px 14px;border-radius:8px;font-size:.9rem;margin:0 0 10px 0;}
    .banner.err{background:#fef2f2;color:#b91c1c;} .banner.warn{background:#fffbeb;color:#b45309;} .banner.ok{background:#ecfdf5;color:#047857;}
    .composer{padding:8px 16px 10px;border-top:1px solid #e2e8f0;display:block;height:210px;overflow:hidden;}
    textarea#nl{display:block;width:100%;font:inherit;border:1px solid #e2e8f0;border-radius:14px;padding:10px 14px;resize:none;height:118px;max-height:118px;box-sizing:border-box;}
    .btn{font:inherit;font-weight:600;border:none;border-radius:8px;padding:8px 16px;cursor:pointer;background:#2563eb;color:#fff;}
    .btn:disabled{opacity:.5;cursor:not-allowed;} .btn-outline{background:#fff;color:#0f172a;border:1px solid #e2e8f0;}
    .actions{display:block;margin-top:6px;}
    .hidden{display:none !important;}
    .tw-modal{position:fixed;left:0;top:0;width:100%;height:100%;z-index:9999;}
    .tw-modal.hidden{display:none !important;}
    .tw-modal-backdrop{position:absolute;left:0;top:0;width:100%;height:100%;background:#0f172a;opacity:0.45;}
    .tw-modal-box{position:absolute;left:50%;top:120px;width:360px;margin-left:-180px;background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:16px 18px;box-shadow:0 8px 24px rgba(15,23,42,0.18);}
    .tw-modal-box h3{font-size:1rem;margin:0 0 8px;color:#0f172a;}
    .tw-modal-box p{font-size:.85rem;margin:0 0 10px;color:#64748b;line-height:1.45;}
    .tw-modal-box input{display:block;width:100%;box-sizing:border-box;font:inherit;border:1px solid #e2e8f0;border-radius:8px;padding:8px 10px;margin:0 0 12px 0;}
    .tw-modal-actions{text-align:right;}
    .tw-modal-actions .btn{margin-left:8px;}
    details summary{cursor:pointer;font-size:.82rem;color:#64748b;}
    .slot-card{border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px;margin-bottom:10px;font-size:.88rem;}
    .slot-card .badge{display:inline-block;font-size:.72rem;font-weight:700;padding:2px 8px;border-radius:999px;margin-left:6px;}
    .badge-feasible{background:#ecfdf5;color:#047857;}
    .badge-no_value,.badge-no_column{background:#fef2f2;color:#b91c1c;}
    .badge-ambiguous,.badge-partially_infeasible{background:#fffbeb;color:#b45309;}
    .badge-low{border:1px dashed #b45309;}
    .alt-chip{display:inline-block;font-size:.78rem;padding:4px 10px;margin:0 6px 6px 0;border-radius:999px;border:1px solid #e2e8f0;cursor:pointer;background:#f8fafc;}
    #nlHints{display:block;margin:0 0 6px 0;min-height:0;}
    body.embed{background:#fff;height:auto;overflow:auto;margin:0;padding:0;}
    body.embed .app{display:block;max-width:none;width:auto;height:auto;border:none;background:#fff;}
    body.embed .header{display:block;padding:4px 8px;border-bottom:1px solid #e2e8f0;}
    body.embed .header h1{font-size:.82rem;display:inline;margin:0;color:#0f172a;}
    body.embed .header a.open-browser{
      display:inline-block;margin-left:8px;font-size:.72rem;font-weight:600;
      color:#2563eb;text-decoration:none;border:1px solid #bfdbfe;border-radius:6px;
      padding:1px 6px;background:#eff6ff;vertical-align:middle;
    }
    body.embed .header .wf{font-size:.65rem;display:block;margin-top:1px;color:#64748b;}
    body.embed #twInfoBar{height:40px;line-height:40px;padding:0 8px;font-size:.75rem;}
    body.embed #twMainTable{height:510px;}
    body.embed #twLeftCol,body.embed #twListPane{height:510px;}
    body.embed #twAnswer{height:320px;padding:6px 8px;}
    body.embed #twListPane{padding:6px 8px;}
    body.embed #twDummyList,body.embed #sideSql{height:460px;}
    body.embed .composer{height:190px;padding:6px 8px;}
    body.embed textarea#nl{height:106px;max-height:106px;padding:6px 10px;border-radius:10px;font-size:.85rem;}
    body.embed .actions{margin-top:4px;}
    body.embed .btn{padding:6px 12px;font-size:.85rem;border-radius:6px;}
    body.embed #hint{font-size:.72rem;padding:4px 8px;line-height:1.35;color:#047857;}
    body.embed .card{padding:6px 8px;border-radius:8px;margin:0 0 8px 0;}
    body.embed .card h2{font-size:.7rem;margin:0 0 4px;color:#64748b;}
    body.embed .chip{font-size:.72rem;padding:3px 8px;}
    body.embed .gates{font-size:.72rem;}
    body.embed pre.code{font-size:.7rem;padding:8px;max-height:120px;}
    body.embed #twRecentNl{display:block;font-size:.68rem;padding:4px 8px 6px;}
    body.embed #twDiag{display:block;font-size:.68rem;padding:4px 8px 8px;}
    body.embed #twDiagLog{display:block;max-height:100px;}
    body.embed .sql-item{padding:6px 44px 6px 6px;margin-bottom:6px;font-size:.78rem;border-radius:6px;}
    body.embed .shell-item{padding:6px;font-size:.78rem;}
  </style>
  <script type="text/javascript">
    window.__TW_LOGIN__ = '<%= _twEscJs(_login) %>';
    window.__TW_EMBED__ = <%= _embed ? "true" : "false" %>;
    window.__TW_MATCH_ENABLED__ = <%= _matchEnabled ? "true" : "false" %>;
    /* IE onerror: (msg,url,line,col,errObj) — StudioJs 가 덮어쓰며 #twDiagLog 에도 기록 */
    window.onerror = function (msg, url, line, col, errObj) {
      try {
        var boot = document.getElementById("twBoot");
        var tbl = document.getElementById("twBootTable");
        if (boot) {
          boot.className = "tw-boot-show";
          boot.style.background = "#fef2f2";
          boot.style.color = "#b91c1c";
          boot.innerHTML = "JS error: " + msg + " @" + line + (url ? (" | " + url) : "");
        }
        if (tbl) tbl.className = "tw-boot-show";
        var h = document.getElementById("hint");
        if (h) {
          h.className = "banner err";
          h.textContent = "Studio JS error: " + msg + " @" + line;
        }
        var d = document.getElementById("twDiagLog");
        if (d) {
          var t = document.createElement("div");
          t.appendChild(document.createTextNode(
            "boot onerror: " + msg + " | line=" + line +
            (col != null ? (" | col=" + col) : "") +
            (url ? (" | " + url) : "")
          ));
          d.appendChild(t);
        }
      } catch (e0) {}
      return false;
    };
  </script>
</head>
<body class="<%= _embed ? "embed" : "" %>">
  <!-- 오류 시에만 표시(#136). 정상 시 숨기고 진단 패널에만 기록 -->
  <table id="twBootTable" width="100%" bgcolor="#FFFF00" border="0" cellspacing="0" cellpadding="3" class="tw-boot-show">
    <tr><td>
      <font id="twBootFont" face="Tahoma" size="2" color="#000000">TW-BOOT v=197 | loading&#x2026;</font>
    </td></tr>
  </table>
  <div id="twBoot" class="tw-boot-show">Studio boot&#x2026;</div>
  <script type="text/javascript">
  (function () {
    var dm = (typeof document.documentMode !== "undefined") ? String(document.documentMode) : "n/a(non-IE)";
    var emb = window.__TW_EMBED__ ? "1" : "0";
    var r = "";
    try {
      var s = String(location.search || "");
      var key = "_r=";
      var i = s.indexOf(key);
      if (i >= 0) {
        var rest = s.substring(i + key.length);
        var amp = rest.indexOf("&");
        r = amp < 0 ? rest : rest.substring(0, amp);
      }
    } catch (eR) {}
    var msg = "TW-BOOT v=197 | documentMode=" + dm + " | embed=" + emb + " | match=" + (window.__TW_MATCH_ENABLED__ ? "1" : "0") + " | _r=" + (r || "-");
    var font = document.getElementById("twBootFont");
    if (font) font.innerHTML = msg;
    var el = document.getElementById("twBoot");
    if (el) el.innerHTML = "boot ok | " + msg;
    window.__TW_BOOT_MSG__ = msg;
  })();
  </script>
  <div class="app">
    <div class="header">
      <h1>Test Woo AI Studio<%= _embed ? " (embedded)" : "" %></h1>
<%
  if (_embed) {
    var _browserUrl = "/woo/testWooAiStudio.jssp?workflowName=" + encodeURIComponent(_wf || "");
%>
      <a class="open-browser" id="twOpenBrowser" href="<%= _twHtmlEsc(_browserUrl) %>" target="_blank" rel="noopener">&#xBE0C;&#xB77C;&#xC6B0;&#xC800;&#xB85C; &#xBCF4;&#xAE30;</a>
<%
  }
%>
      <span class="wf" id="wfInfo">user: <%= _twEscJs(_login) %> / register&#x2192;ai_sql_id</span>
    </div>

    <div id="twInfoBar">
      <span id="twInfoText">&#xC870;&#xAC74; &gt; SQL</span>
      <span id="twInfoActions">
        <button type="button" class="btn-mini" id="btnTwOpenWkf" disabled="disabled">WKF &#xC5F4;&#xAE30; &#xC548;&#xB0B4;</button>
        <button type="button" class="btn-mini hidden" id="btnTwOtherWkf" disabled="disabled">&#xB2E4;&#xB978; WKF&#xC5D0;&#xB3C4; &#xBC18;&#xC601;</button>
        <button type="button" class="btn-mini" id="btnTwBack">&#xB4A4;&#xB85C;</button>
        <button type="button" class="btn-mini" id="btnTwReset">&#xCD08;&#xAE30;&#xD654;</button>
      </span>
    </div>

    <table id="twMainTable" cellspacing="0" cellpadding="0">
      <tr>
        <td id="twLeftCol">
          <div class="main" id="twAnswer">
            <div class="banner ok" id="hint">&#xC790;&#xC5F0;&#xC5B4;&#xB85C; &#xB300;&#xC0C1; &#xC870;&#xAC74;&#xC744; &#xC785;&#xB825;&#xD558;&#xC138;&#xC694;. &#xD55C; &#xBB38;&#xC7A5;&#xC73C;&#xB85C; &#xBB49;&#xCCD0;&#xB3C4; &#xB429;&#xB2C8;&#xB2E4;. &#xC608;) &#xCD5C;&#xADFC; &#xD55C;&#xB2EC; Y&#xC694;&#xAE08; &#xAC00;&#xC785;&#xD55C; 1020&#xC138;&#xB300; &#xC911; &#xC218;&#xC2E0;&#xB3D9;&#xC758;&#xD558;&#xACE0; &#xB9C8;&#xCF00;&#xD305; &#xBA54;&#xC2DC;&#xC9C0;&#xB97C; &#xD55C;&#xBC88;&#xB3C4; &#xBC1B;&#xC9C0;&#xC54A;&#xC740; &#xACE0;&#xAC1D;</div>

            <div class="card hidden" id="cardSlotResults"><h2>&#xC2AC;&#xB86F; &#xD310;&#xC815; / &#xBD88;&#xAC00; &#xBCF4;&#xACE0;</h2><div id="slotResults"></div></div>

            <div class="card hidden" id="cardChips"><h2>&#xD574;&#xC11D;&#xD55C; &#xC870;&#xAC74;</h2><div class="chip-line" id="chipLine"></div><div class="chips" id="chips"></div></div>

            <div class="card hidden" id="cardGates"><h2>&#xC900;&#xBE44; &#xC0C1;&#xD0DC;</h2><div class="gates" id="gates"></div></div>

            <div class="card hidden" id="cardCode">
              <div><div style="font-size:.82rem;color:#64748b;cursor:default;">&#xCF54;&#xB4DC; &#xBCF4;&#xAE30; (SQL)</div><pre class="code" id="sql"></pre></div>
            </div>

            <div class="banner err hidden" id="err"></div>
          </div>
          <div class="composer">
            <div id="nlHints"></div>
            <div id="twNlHint" class="hidden">&#xC870;&#xAC74;&#xC744; &#xC785;&#xB825;&#xD55C; &#xB4A4; [&#xB300;&#xC0C1; &#xB9CC;&#xB4E4;&#xAE30;]&#xB97C; &#xB204;&#xB974;&#xC138;&#xC694;</div>
            <textarea id="nl" rows="1"></textarea>
            <div class="actions">
              <button type="button" class="btn" id="btnGen">&#xB300;&#xC0C1; &#xB9CC;&#xB4E4;&#xAE30;</button>
              <button type="button" class="btn btn-outline" id="btnReg" disabled="disabled">&#xC774; &#xC870;&#xAC74; &#xC4F0;&#xAE30;</button>
              <button type="button" class="btn btn-outline" id="btnTwGotoWkf" disabled="disabled">WKF&#xB85C; &#xC774;&#xB3D9;</button>
            </div>
          </div>
        </td>
        <td id="twListPane">
          <h2 id="twListTitle">&#xB0B4; &#xC870;&#xAC74;</h2>
          <div id="twDummyList"></div>
          <div class="side" id="sideSql" style="display:none">
            <div class="side-empty" id="sqlListEmpty">&#xB4F1;&#xB85D;&#xB41C; SQL &#xC774; &#xC5C6;&#xC2B5;&#xB2C8;&#xB2E4;. &#xC0DD;&#xC131; &#xD6C4; &#xB4F1;&#xB85D;&#xD558;&#xBA74; &#xC5EC;&#xAE30; &#xBAA8;&#xC785;&#xB2C8;&#xB2E4;.</div>
            <div id="sqlList"></div>
          </div>
        </td>
      </tr>
    </table>

    <div id="twRecentNl">
      <div class="tw-rq-h">&#xC774;&#xBC88; &#xC9C8;&#xBB38; (&#xB2F9;&#xC0AC;&#xC790;)</div>
      <div id="twRecentList"><div class="tw-rq-empty">&#xC544;&#xC9C1; &#xBCF4;&#xB0B8; &#xC9C8;&#xBB38;&#xC774; &#xC5C6;&#xC2B5;&#xB2C8;&#xB2E4;.</div></div>
    </div>
    <div id="twDiag">
      <div id="twDiagSum" style="cursor:pointer;font-weight:600;margin-bottom:4px;">&#xC9C4;&#xB2E8; (IE / urlViewer) &#x2014; &#xD074;&#xB9AD;&#xD558;&#xC5EC; &#xC811;&#xAE30;</div>
      <div id="twDiagLog" style="display:block;"></div>
    </div>
    <div id="twLabelModal" class="tw-modal hidden">
      <div class="tw-modal-backdrop" id="twLabelModalBackdrop"></div>
      <div class="tw-modal-box">
        <h3 id="twLabelModalTitle">&#xC774;&#xB984; &#xC785;&#xB825;</h3>
        <p id="twLabelModalMsg">&#xD45C;&#xC2DC; &#xC774;&#xB984;&#xC744; &#xC785;&#xB825;&#xD55C; &#xB4A4; [&#xB9CC;&#xB4E4;&#xAE30;]&#xB97C; &#xB204;&#xB974;&#xC138;&#xC694;.</p>
        <input type="text" id="twLabelModalInput" value="" maxlength="120" />
        <div class="tw-modal-actions">
          <button type="button" class="btn btn-outline" id="twLabelModalCancel">&#xCDE8;&#xC18C;</button>
          <button type="button" class="btn" id="twLabelModalOk">&#xB9CC;&#xB4E4;&#xAE30;</button>
        </div>
      </div>
    </div>
  </div>

  <!-- v=197 · orphan SQL — draft 캐시 + Program 매핑 자동 진입 -->
  <script type="text/javascript" src="/woo/testWooAiStudioJs.jssp?v=197"></script>
</body>
</html>
<%
}
%>
