<%
response.setContentType("application/json;charset=utf-8");
/*
 * testWooAiQueueStatus.jssp (Foundry 큐 상태 API)
 * ==================================================
 * Generate가 enqueue한 request_queue 행의 진행 상태를 조회.
 * Studio 클라이언트가 폴링하여 done/failed를 감지한다.
 *
 * [Main Functions]
 * ===========
 * - getQueueStatus — queueId→status·fragmentId·message·promptHints
 *
 * [Dependencies]
 * =========
 * - woo:testWooCommon.js, testWooRepository.js
 * - right testWooAiSqlGenerate · schema woo:testWooAiRequestQueue
 */
try {
  TW_RESPONSE = response;
  TW_REQUEST = request;
  TW_DOCUMENT = document;
  loadLibrary("woo:testWooCommon.js");
  loadLibrary("woo:testWooRepository.js");
  requireRight("testWooAiSqlGenerate");

  var p = readPayload();
  var qid = p.queueId || p.queue_id;
  if (!qid) {
    try { qid = String(request.getParameter("queueId") || ""); } catch (eP) {}
  }
  if (!qid) throw new Error("queueId missing");

  var st = testWoo.repo.getQueueStatus(Number(qid));
  if (!st) {
    jsonOut({ ok: false, error: "queue not found" });
  } else {
    var dbg = [];
    var ev = (st && st.evidenceLog) ? st.evidenceLog : [];
    var ei, er;
    for (ei = 0; ei < ev.length; ei++) {
      er = ev[ei];
      if (er && er.reason === "debugTrace" && er.lines && er.lines.length)
        dbg = er.lines;
    }
    var promptHints = [];
    var sr = (st && st.slotResults) || [];
    var hi, hs;
    for (hi = 0; hi < sr.length; hi++) {
      hs = sr[hi] || {};
      if (hs.promptHints && hs.promptHints.length) {
        promptHints = hs.promptHints;
        break;
      }
    }
    jsonOut({
      ok: true,
      queue: st,
      promptHints: promptHints,
      debugOn: dbg.length > 0,
      debugTrace: dbg
    });
  }
} catch (e) {
  handleApiError(e);
}
%>
