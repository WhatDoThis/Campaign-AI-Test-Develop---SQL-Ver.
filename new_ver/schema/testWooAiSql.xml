<srcSchema _cs="Test Woo AI Generated SQL (woo)" mappingType="sql" name="testWooAiSql" namespace="woo"
           label="Test Woo AI Generated SQL" labelSingular="Test Woo AI Generated SQL" xtkschema="xtk:srcSchema">

  <!--
    testWooAiSql — Generate/Register된 대상자 SQL 이력
    sqltable: testWooAiSql · idx: workflow_name, workflow_name+injected_at
    소비: testWooRepository.js · Register · WKF SQL 목록 · inject 메타

    enum status | draft · validated · registered · rejected
    enum impact_status | ok · affected · blocked

    컬럼 | 용도 | 예시
    @id | PK · Register 후 ai_sql_id | 44628
    title | Studio 표시 제목(max 200) | iOS·학생요금·여자
    creator | 생성자 로그인 | hiwoo
    nl_request | 원본 NL 질문(memo) | iOS 사용하고 학생요금제…
    plan_json | compiler CNF plan JSON(memo) | {"clauses":[…]}
    used_fragments | 사용 fragment name 목록(memo) | woo__device__os,woo__customer__gender
    param_key | 조건축 fingerprint(값 제외 유사 비교) | device.os|subscription.plan|customer.gender
    compile_hash | sql_query 해시 | a1b2c3…
    sql_query | 최종 대상자 SQL(memo) | SELECT …
    summary_ko | 요약 한 줄 | iOS·학생요금·여자 고객
    target_count | 예상 건수(게이트/집계) | 12500
    workflow_name | 연결 WKF internalName | WKF214
    excluded_slots | 제외 슬롯 JSON(memo) | []
    has_exclusion | 제외 조건 포함 여부 | false
    status | sqlHistoryStatus | registered
    impact_status | 영향/차단 상태 | ok
    creation_date | DB 등록 시각 | 2026-09-02 16:20:43
    injected_at | WKF canvas inject 시각(null=미반영) | 2026-09-02 16:21:00
    injected_by | inject 실행 로그인 | hiwoo
    inject_count | inject 횟수 | 1
    activity_name | inject 대상 activity @name | aiStudioSql
    prev_injected_id | 덮어쓰기 전 ai_sql_id | 0
    injected_workflow_id | inject WKF id | 44628
  -->
  <enumeration basetype="string" default="draft" name="sqlHistoryStatus">
    <value label="Draft"      name="draft"/>
    <value label="Validated"  name="validated"/>
    <value label="Registered" name="registered"/>
    <value label="Rejected"   name="rejected"/>
  </enumeration>
  <enumeration basetype="string" default="ok" name="sqlImpactStatus">
    <value label="OK"        name="ok"/>
    <value label="Affected"  name="affected"/>
    <value label="Blocked"   name="blocked"/>
  </enumeration>

  <element autopk="true" label="Test Woo AI Generated SQL" name="testWooAiSql" sqltable="testWooAiSql">
    <dbindex name="idx_wf">
      <keyfield xpath="@workflow_name"/>
    </dbindex>
    <dbindex name="idx_wf_inj">
      <keyfield xpath="@workflow_name"/>
      <keyfield xpath="@injected_at"/>
    </dbindex>

    <attribute label="Title"           length="200" name="title"         type="string"/>
    <attribute label="Creator"         length="64"  name="creator"       type="string"/>
    <attribute label="NL Request"      name="nl_request"    type="memo"/>
    <attribute label="Plan JSON"       name="plan_json"     type="memo"/>
    <attribute label="Used Fragments"  name="used_fragments" type="memo"/>
    <attribute label="Param Key"       length="200" name="param_key"     type="string"/>
    <attribute label="Compile Hash"    length="64"  name="compile_hash"  type="string"/>
    <attribute label="Generated SQL"   name="sql_query"     type="memo"/>
    <attribute label="Summary KO"      length="500" name="summary_ko"    type="string"/>
    <attribute label="Target Count"    name="target_count"  type="long"/>
    <attribute label="Workflow Name"   length="64"  name="workflow_name" type="string"/>
    <attribute label="Excluded Slots"  name="excluded_slots" type="memo"/>
    <attribute label="Has Exclusion"   name="has_exclusion" type="boolean" default="false"/>
    <attribute enum="sqlHistoryStatus" label="Status" length="16" name="status" type="string"/>
    <attribute enum="sqlImpactStatus" label="Impact Status" length="16" name="impact_status" type="string"/>
    <attribute label="Creation Date"   name="creation_date" type="datetime"/>
    <attribute label="Injected At"     name="injected_at" type="datetime"/>
    <attribute label="Injected By"     length="64" name="injected_by" type="string"/>
    <attribute label="Inject Count"    name="inject_count" type="long" default="0"/>
    <attribute label="Activity Name"   length="64" name="activity_name" type="string"/>
    <attribute label="Prev Injected Id" name="prev_injected_id" type="long" default="0"/>
    <attribute label="Injected Workflow Id" length="16" name="injected_workflow_id" type="string"/>
  </element>
</srcSchema>
