<srcSchema _cs="Test Woo Sample Device (woo)" mappingType="sql" name="testWooSampleDevice" namespace="woo"
           label="Test Woo Sample Device" labelSingular="Test Woo Sample Device" xtkschema="xtk:srcSchema">
  <element autopk="true" label="Test Woo Sample Device" name="testWooSampleDevice" sqltable="testWooSampleDevice">
    <dbindex name="idx_os_net">
      <keyfield xpath="@os"/>
      <keyfield xpath="@network_gen"/>
    </dbindex>
    <key name="byCustomerId">
      <keyfield xpath="@customer_id"/>
    </key>

    <attribute label="Customer ID"  length="32" name="customer_id"  type="string"/>
    <attribute label="OS"           length="16" name="os"           type="string"/>
    <attribute label="Maker"        length="16" name="maker"        type="string"/>
    <attribute label="Network Gen"  length="8"  name="network_gen"  type="string"/>
    <attribute label="Start Date" name="start_date" type="date"/>
  </element>
</srcSchema>
