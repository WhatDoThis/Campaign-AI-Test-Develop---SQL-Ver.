<srcSchema _cs="Test Woo AI Gap Log (woo)" mappingType="sql" name="testWooAiGapLog" namespace="woo"
           label="Test Woo AI Gap Log" labelSingular="Test Woo AI Gap Log" xtkschema="xtk:srcSchema">

  <!--
    testWooAiGapLog — 카탈로그에 없는 NL 축/개념 누적 (운영 gap 추적)
    sqltable: testWooAiGapLog · idx: normalized_concept
    소비: testWooRepository.js · Foundry gap skip 기록

    enum status | open · planned · resolved · wontfix

    컬럼 | 용도 | 예시
    @id | PK | 501
    slot_text | 사용자 NL 표면/슬롯 원문(memo) | 프리미엄 요금제
    verdict | 매칭/실현 판정 | no_fragment
    normalized_concept | 정규화 concept 키 | plan_type.premium
    request_count | 동일 gap 누적 요청 수 | 7
    first_seen_at / last_seen_at | 최초·최근 발생 시각 | 2026-08-01 · 2026-09-02
    sample_evidence | 대표 증거 JSON(memo) | {"en":"premium plan"}
    status | gapLogStatus | open
    note | 운영 메모(memo) | Q4 fragment 추가 예정
  -->
  <enumeration basetype="string" default="open" name="gapLogStatus">
    <value label="Open"     name="open"/>
    <value label="Planned"  name="planned"/>
    <value label="Resolved" name="resolved"/>
    <value label="Wont Fix" name="wontfix"/>
  </enumeration>

  <element autopk="true" label="Test Woo AI Gap Log" name="testWooAiGapLog" sqltable="testWooAiGapLog">
    <dbindex name="idx_concept">
      <keyfield xpath="@normalized_concept"/>
    </dbindex>

    <attribute label="Slot Text"          name="slot_text"           type="memo"/>
    <attribute label="Verdict"            length="24"  name="verdict"           type="string"/>
    <attribute label="Normalized Concept" length="128" name="normalized_concept" type="string"/>
    <attribute label="Request Count"      name="request_count"       type="long" default="1"/>
    <attribute label="First Seen At"      name="first_seen_at"       type="datetime"/>
    <attribute label="Last Seen At"       name="last_seen_at"        type="datetime"/>
    <attribute label="Sample Evidence"    name="sample_evidence"     type="memo"/>
    <attribute enum="gapLogStatus" label="Status" length="16" name="status" type="string"/>
    <attribute label="Note"               name="note"                type="memo"/>
  </element>
</srcSchema>
