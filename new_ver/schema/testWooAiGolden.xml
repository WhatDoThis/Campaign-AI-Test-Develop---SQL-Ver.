<!--
woo:testWooAiGolden (회귀 테스트셋)
====================================
골든 NL → expectedFragments / count range.

[Dependencies]
=========
- workflow/testWooGoldenRun.js
-->
<srcSchema _cs="Test Woo AI Golden Test (woo)" mappingType="sql" name="testWooAiGolden" namespace="woo"
           label="Test Woo AI Golden Test" labelSingular="Test Woo AI Golden Test" xtkschema="xtk:srcSchema">
  <enumeration basetype="string" default="skip" name="goldenResult">
    <value label="Pass" name="pass"/>
    <value label="Fail" name="fail"/>
    <value label="Skip" name="skip"/>
  </enumeration>

  <element autopk="true" label="Test Woo AI Golden Test" name="testWooAiGolden" sqltable="testWooAiGolden">
    <attribute label="NL Text"            name="nl_text"            type="memo"/>
    <attribute label="Expected Fragments" name="expected_fragments" type="memo"/>
    <attribute label="Expected Count Min" name="expected_count_min" type="long"/>
    <attribute label="Expected Count Max" name="expected_count_max" type="long"/>
    <attribute label="Note"               name="note"               type="memo"/>
    <attribute label="Expected Verdict"   length="24"  name="expected_verdict" type="string"/>
    <attribute label="Case Type"          length="16"  name="case_type"        type="string"/>
    <attribute label="Last Run At"        name="last_run_at"        type="datetime"/>
    <attribute enum="goldenResult" label="Last Result" length="16" name="last_result" type="string"/>
  </element>
</srcSchema>
