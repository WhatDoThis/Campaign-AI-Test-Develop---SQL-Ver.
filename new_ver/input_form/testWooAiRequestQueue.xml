      xtkschema="xtk:form">
  <container label="Summary">
    <input xpath="@nl_text"/>
    <input xpath="@status"/>
    <input xpath="@attempt_count"/>
    <input xpath="@last_error"/>
    <input xpath="@missing_slots_json"/>
    <input xpath="@created_by"/>
    <input xpath="@workflow_name"/>
    <input xpath="@created_at"/>
    <input xpath="@updated_at"/>
  </container>
  <container label="Plan">
    <input xpath="@slots_json"/>
    <input xpath="@plan_json"/>
    <input xpath="@partial_preview"/>
  </container>
  <container label="Triage">
    <input xpath="@slot_results"/>
    <input xpath="@evidence_log"/>
    <input xpath="@clarify_answers"/>
  </container>
</form>
