<!--
woo:testWooExtendWorkflow (Workflow 확장 Input form · Test Woo AI Studio)
====================================================================
Studio(urlViewer) + 하단 Apply. urlViewer 는 container height 로 공간 예약(#130 흰 화면).
SOAP: ShellProbe / ShellPick / ShellBind 만 (구 Inspect*/Bind* 호출 금지).

액티비티 없을 때: Status 에 [안내] 문구, Activity 빈칸, Apply 시 check 오류.

[Deploy]
=========
schema testWooAiWorkflowUi → JS testWooWorkflowUi.js → 이 폼 (동시)
콘솔 methods 에 ShellProbe 존재 확인 후 폼 저장.
-->
<form _cs="Workflow Test Woo AI extend (woo)" entity-schema="xtk:workflow" entitySchema="xtk:form"
      img="xtk:form.png" label="Workflow Test Woo AI extend" name="testWooExtendWorkflow"
      namespace="woo" xtkschema="xtk:form">

  <container name="lib" type="visibleGroup" visibleIf="false">
    <form colcount="3" label="Test Woo AI Studio" name="aiStudio"
          nothingToEdit="true" nothingToSave="true">

      <enter>
        <soapCall name="ShellProbe" service="woo:testWooAiWorkflowUi">
          <param exprIn="[activities]" type="DOMElement"/>
          <param type="string" xpathOut="/tmp/@testWooHasAiActivity"/>
          <param type="string" xpathOut="/tmp/@testWooAiStatus"/>
          <param type="string" xpathOut="/tmp/@testWooAiActivityName"/>
        </soapCall>
        <soapCall name="ShellPick" service="woo:testWooAiWorkflowUi">
          <param exprIn="@internalName" type="string"/>
          <param type="string" xpathOut="/tmp/@testWooAiSqlId"/>
          <param type="string" xpathOut="/tmp/@testWooAiSqlPickLabel"/>
        </soapCall>
      </enter>

      <!-- height: Apply/재오픈 후 urlViewer 가 0높이로 접히는 것 방지 (#130) -->
      <container colspan="3" height="520" name="twStudioViewer" nolabel="true">
        <input colspan="3" nolabel="true" sessionToken="true" type="urlViewer"
               urlExpr="$(serverUrl) + '/woo/testWooAiStudio.jssp?workflowName=' + @internalName + '&amp;embed=1'"/>
      </container>

      <static colspan="3" label="Apply to canvas" type="separator"/>
      <!-- 액티비티 없음 / SQL 미선택 안내 (ShellProbe·ShellPick message) -->
      <input colspan="3" label="Status" readOnly="true" xpath="/tmp/@testWooAiStatus"/>
      <input colspan="3" label="Workflow" readOnly="true" xpath="@internalName"/>
      <input label="Activity" readOnly="true" xpath="/tmp/@testWooAiActivityName"/>
      <input label="SQL (ai_sql_id)" readOnly="true" xpath="/tmp/@testWooAiSqlId"/>
      <input type="button" name="btnTestWooBindAiSql" label="Apply" img="xtk:properties.png">
        <enter>
          <soapCall name="ShellPick" service="woo:testWooAiWorkflowUi">
            <param exprIn="@internalName" type="string"/>
            <param type="string" xpathOut="/tmp/@testWooAiSqlId"/>
            <param type="string" xpathOut="/tmp/@testWooAiSqlPickLabel"/>
          </soapCall>
          <check expr="[/tmp/@testWooAiSqlId] != ''">
            <error>Studio SQL 이력에서 항목을 클릭하거나 등록한 뒤 Apply 하세요.</error>
          </check>
          <check expr="[/tmp/@testWooHasAiActivity] = 'true'">
            <error>캔버스에 AI 대상자 추출(ibankSqlDM)이 없습니다. 팔레트에서 추가한 뒤 다시 여세요.</error>
          </check>
          <soapCall name="ShellBind" service="woo:testWooAiWorkflowUi">
            <param exprIn="[activities]" type="DOMElement"/>
            <param exprIn="[/tmp/@testWooAiSqlId]" type="string"/>
            <param exprIn="@internalName" type="string"/>
            <param type="DOMElement" xpathOut="activities"/>
          </soapCall>
          <setModified/>
          <soapCall name="ShellProbe" service="woo:testWooAiWorkflowUi">
            <param exprIn="[activities]" type="DOMElement"/>
            <param type="string" xpathOut="/tmp/@testWooHasAiActivity"/>
            <param type="string" xpathOut="/tmp/@testWooAiStatus"/>
            <param type="string" xpathOut="/tmp/@testWooAiActivityName"/>
          </soapCall>
          <soapCall name="ShellPick" service="woo:testWooAiWorkflowUi">
            <param exprIn="@internalName" type="string"/>
            <param type="string" xpathOut="/tmp/@testWooAiSqlId"/>
            <param type="string" xpathOut="/tmp/@testWooAiSqlPickLabel"/>
          </soapCall>
          <set value="Applied. Save the workflow." xpath="/tmp/@testWooAiStatus"/>
        </enter>
      </input>

    </form>
  </container>

</form>
