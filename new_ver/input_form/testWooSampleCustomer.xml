<!--
woo:testWooSampleCustomer (Test Woo Sample Customer Form)
listdet 연결: form name = 스키마 name. @name xpath 는 ACC 예약과 충돌 가능 → customer_name 표시용 colname
-->
<form _cs="Test Woo Sample Customer" entity-schema="woo:testWooSampleCustomer" img="xtk:form.png"
      label="Test Woo Sample Customer" name="testWooSampleCustomer" namespace="woo" type="notebook"
      xtkschema="xtk:form">
  <container label="Identity">
    <input xpath="@customer_id"/>
    <input xpath="@name"/>
    <input xpath="@age"/>
    <input xpath="@gender"/>
    <input xpath="@birth_date"/>
  </container>
  <container label="Profile">
    <input xpath="@region"/>
    <input xpath="@email"/>
    <input xpath="@status"/>
    <input xpath="@created_date"/>
  </container>
  <container label="Consent">
    <input xpath="@marketing_consent"/>
    <input xpath="@sms_consent"/>
  </container>
</form>
