<!--
woo:testWooAiSql (Test Woo AI Generated SQL Form)
listdet 하단 잘림 방지: form type=notebook + navtree type=list(더블클릭 Open)
ACC Input forms 에 본 XML 전체 재등록(type=notebook 줄 확인)
-->
<form _cs="Test Woo AI Generated SQL" entity-schema="woo:testWooAiSql" img="xtk:form.png"
      label="Test Woo AI Generated SQL" name="testWooAiSql" namespace="woo" type="notebook"
      xtkschema="xtk:form">
  <container label="Header">
    <input xpath="@title"/>
    <input xpath="@creator"/>
    <input xpath="@status"/>
    <input xpath="@workflow_name"/>
    <input xpath="@target_count"/>
    <input xpath="@creation_date"/>
    <input xpath="@impact_status"/>
    <input xpath="@injected_at"/>
    <input xpath="@injected_by"/>
    <input xpath="@inject_count"/>
    <input xpath="@activity_name"/>
    <input xpath="@prev_injected_id"/>
    <input xpath="@injected_workflow_id"/>
  </container>
  <container label="Request">
    <input xpath="@nl_request"/>
    <input xpath="@summary_ko"/>
  </container>
  <container label="Plan">
    <input xpath="@plan_json"/>
    <input xpath="@used_fragments"/>
    <input xpath="@param_key"/>
    <input xpath="@compile_hash"/>
    <input xpath="@excluded_slots"/>
    <input xpath="@has_exclusion"/>
  </container>
  <container label="SQL">
    <input xpath="@sql_query"/>
  </container>
</form>
