<!--
woo:testWooAiWorkflowUi (Test Woo AI Workflow UI · SOAP method host)
====================================================================
확장 폼 ↔ Studio. 구 메서드명(InspectAiTarget/BindAiSqlId/…) 은 시그니처 오염이
반복되어 폐기하고 Shell* 만 사용한다 (SOP-330003 / Too many arguments 회피).

[Main Functions]
===========
- ShellProbe(activities) → hasActivity, message, activityName  (out×3)
- ShellPick(workflowName) → aiSqlId, pickLabel, tick (캐시버스트 · Date.getTime)
- ShellBind(activities, aiSqlId, workflowName) → activitiesOut  (첫 AI 액티비티 · registered SQL script)
- 폼에 FormatDate/GetDate 금지 (XTK-170016 SQL expressions)

[Deploy — 반드시 동시]
===========
1) 이 스키마  2) testWooWorkflowUi.js  3) testWooExtendWorkflow 폼
콘솔에서 methods 에 ShellProbe/ShellPick/ShellBind 만 보이는지 확인.

[Dependencies]
=========
- XtkOption: testWooAiBindPick_<login>
- 계약: sqlDM @name=aiStudioSql · userScript + ai-sql-id
-->
<srcSchema _cs="Test Woo AI Workflow UI (woo)" name="testWooAiWorkflowUi" namespace="woo"
           label="Test Woo AI Workflow UI" labelSingular="Test Woo AI Workflow UI"
           xtkschema="xtk:srcSchema">
  <element label="Test Woo AI Workflow UI" name="testWooAiWorkflowUi"/>

  <methods>
    <method name="ShellProbe" static="true" library="woo:testWooWorkflowUi.js"
            label="Probe first AI extract activity">
      <help>
        Scans sqlDM @name=aiStudioSql (campaign template wfEmptyTemplate_AI).
        Old customActivity still recognized. Empty canvas → hasActivity=false.
      </help>
      <parameters>
        <param name="activities" type="DOMElement" inout="in"
               desc="Workflow activities element"/>
        <param name="hasActivity" type="string" inout="out"
               desc="true|false"/>
        <param name="message" type="string" inout="out"
               desc="Status / empty-canvas guidance"/>
        <param name="activityName" type="string" inout="out"
               desc="First AI activity @name or empty"/>
      </parameters>
    </method>

    <method name="ShellPick" static="true" library="woo:testWooWorkflowUi.js"
            label="Get Studio bind-pick ai_sql_id">
      <help>
        Reads Option testWooAiBindPick_&lt;login&gt;.
        Third out tick = millis string for urlViewer cache-bust (no FormatDate in form).
      </help>
      <parameters>
        <param name="workflowName" type="string" inout="in"
               desc="Workflow @internalName"/>
        <param name="aiSqlId" type="string" inout="out"
               desc="Selected ai_sql_id or empty"/>
        <param name="pickLabel" type="string" inout="out"
               desc="Human label"/>
        <param name="tick" type="string" inout="out"
               desc="Cache-bust nonce (millis)"/>
      </parameters>
    </method>

    <method name="ShellBind" static="true" library="woo:testWooWorkflowUi.js"
            label="Bind ai_sql_id to first AI activity">
      <help>Writes registered sql_query into sqlDM userScript (AI Studio SQL) plus ai-sql-id. SQL is loaded server-side.</help>
      <parameters>
        <param name="activities" type="DOMElement" inout="in"
               desc="Workflow activities element"/>
        <param name="aiSqlId" type="string" inout="in"
               desc="ai_sql_id (or empty to use pick)"/>
        <param name="workflowName" type="string" inout="in"
               desc="Workflow @internalName for pick"/>
        <param name="activitiesOut" type="DOMElement" inout="out"
               desc="Updated activities"/>
      </parameters>
    </method>
  </methods>
</srcSchema>
