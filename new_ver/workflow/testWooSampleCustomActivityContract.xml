      <initial enabled="true" name="initial" target="aiStudioSql"/>
    </transitions>
  </start>

  <sqlDM andJoin="true" autoCreate="false" collision="0"
         img="xtk:activities/execsql.png" label="SQL Data Management" mask="0"
         name="aiStudioSql" onError="0" useEntity="false"
         x="200" y="80">
    <ai-sql-id>0</ai-sql-id>
    <userScript><![CDATA[]]></userScript>
    <transitions>
      <done enabled="true" label="Ok" name="done" target="changeDataSource"/>
    </transitions>
  </sqlDM>
</activities>
